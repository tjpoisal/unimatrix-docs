{
  "name": "unimatrix",
  "version": "0.1.0",
  "description": "Retrieve project context and save explicit handoffs through the Unimatrix MCP service.",
  "author": {
    "name": "Timothy Poisal"
  },
  "homepage": "https://www.deployunimatrix.com",
  "repository": "https://github.com/tjpoisal/unimatrix-docs",
  "license": "CC-BY-4.0",
  "keywords": [
    "mcp",
    "agent-skills",
    "unimatrix"
  ],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Unimatrix API key",
      "description": "A scoped key from your Unimatrix account.",
      "sensitive": true
    }
  },
  "mcpServers": {
    "unimatrix": {
      "type": "http",
      "url": "https://www.deployunimatrix.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  },
  "privacyPolicyUrl": "https://www.deployunimatrix.com/privacy",
  "termsOfServiceUrl": "https://www.deployunimatrix.com/terms",
  "supportUrl": "https://github.com/tjpoisal/unimatrix-docs/issues"
}
